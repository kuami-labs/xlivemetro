# Copié en .env à la création du conteneur. Le .env n'est JAMAIS commité.

# Base de données (service du compose.yaml)
DATABASE_URL=postgres://xlivemetro:xlivemetro@db:5432/xlivemetro

# Ports
API_PORT=4000
REALTIME_PORT=4100
WEB_URL=http://localhost:3000
# Service temps réel vu par l'API (réseau interne)
REALTIME_URL=http://localhost:4100
# Géocodage des adresses (F17, ADR 0020) : facultatif, IGN Géoplateforme par défaut
# GEOCODER_URL=https://data.geopf.fr/geocodage
# Adresses vues par le navigateur
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4100/ws

# Flux temps réel : synthetic | replay | prim (ADR 0005, 0011)
# synthetic : généré depuis les horaires du référentiel, sans clé
FEED_SOURCE=synthetic
FEED_INTERVAL=30s
REPLAY_DIR=./fixtures/replay
# Décalage d'horloge du service temps réel (synthetic, replay) : voir des trains la nuit, ex. 7h
# CLOCK_OFFSET=7h
# prim : clé personnelle du portail PRIM d'IDFM (https://prim.iledefrance-mobilites.fr)
PRIM_API_KEY=
# Adresses PRIM (par défaut : requêtes globales Estimated Timetable et General Message)
# PRIM_ET_URL=
# PRIM_GM_URL=

# Fonds de carte (styles vectoriels OSM, sans clé) : thèmes sombre et clair
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
NEXT_PUBLIC_MAP_STYLE_URL_LIGHT=https://tiles.openfreemap.org/styles/positron

# Serveur MCP : instance interrogée et carte vers laquelle pointent ses liens
XLIVEMETRO_API_URL=http://localhost:4000
XLIVEMETRO_WEB_URL=http://localhost:3000

# Logs : lisibles en dev, JSON en production ou avec LOG_FORMAT=json
# LOG_LEVEL=info
# LOG_FORMAT=json
# Sentry (optionnel) : vide = rien n'est envoyé
SENTRY_DSN=
